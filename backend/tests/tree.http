@baseUrl = http://localhost:3001

### Get all trees (page 1)
GET {{baseUrl}}/api/trees
Accept: application/json


### Get chêne sessile
GET {{baseUrl}}/api/trees/chene-sessile
Accept: application/json

### Get pin sylvestre
GET {{baseUrl}}/api/trees/pin-sylvestre
Accept: application/json

### Get bouleau blanc
GET {{baseUrl}}/api/trees/bouleau-blanc
Accept: application/json

### Get acajou d'Afrique
GET {{baseUrl}}/api/trees/acajou-afrique
Accept: application/json

### Get séquoia géant
GET {{baseUrl}}/api/trees/sequoia-geant
Accept: application/json

### Get palétuvier rouge
GET {{baseUrl}}/api/trees/paletuvier-rouge
Accept: application/json