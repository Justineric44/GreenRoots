name: Backend CI

on:
  push:
    branches:
      - DEV
      - ci/setup-github-actions

  pull_request:
    branches:
      - DEV

jobs:
  backend-test:
    runs-on: ubuntu-latest

    env:
      POSTGRES_USER: greenroots
      POSTGRES_PASSWORD: testpassword
      POSTGRES_DB: greenroots

      DATABASE_URL: postgresql://greenroots:testpassword@db:5432/greenroots

      POSTGRES_TEST_USER: greenroots
      POSTGRES_TEST_PASSWORD: testpassword
      POSTGRES_TEST_DB: greenroots_test

      TEST_DATABASE_URL: postgresql://greenroots:testpassword@db-test:5432/greenroots_test

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Build and start Docker services
        run: docker compose -f docker-compose.dev.yml up -d --build

      - name: Run Prisma migrations on test database
        run: docker exec greenroots-backend-test npx prisma migrate dev

      - name: Run backend tests
        run: docker exec greenroots-backend-test npm test
